{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node -e \"const fs=require('fs');const p=JSON.parse(fs.readFileSync('vercel.json','utf8'));p.git={...(p.git||{}),deploymentEnabled:false};p.buildCommand='npm run build';fs.writeFileSync('vercel.json',JSON.stringify(p,null,2)+'\\n')\" && npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "git": {
    "deploymentEnabled": true
  },
  "headers": [
    {"source":"/api/runtime-state","headers":[{"key":"Cache-Control","value":"no-store, max-age=0"}]},
    {"source":"/api/wellness/today","headers":[{"key":"Cache-Control","value":"no-store, max-age=0"}]},
    {"source":"/api/training/(.*)","headers":[{"key":"Cache-Control","value":"no-store, max-age=0"}]},
    {"source":"/api/trends/(.*)","headers":[{"key":"Cache-Control","value":"no-store, max-age=0"}]},
    {"source":"/api/system/(.*)","headers":[{"key":"Cache-Control","value":"no-store, max-age=0"}]},
    {"source":"/api/source/(.*)","headers":[{"key":"Cache-Control","value":"no-store, max-age=0"}]},
    {"source":"/","headers":[{"key":"Cache-Control","value":"no-store, max-age=0"}]},
    {"source":"/index.html","headers":[{"key":"Cache-Control","value":"no-store, max-age=0"}]},
    {"source":"/assets/(.*)","headers":[{"key":"Cache-Control","value":"public, max-age=0, must-revalidate"}]}
  ]
}
