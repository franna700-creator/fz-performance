in(points.length-1,i));const p=points[i];halo.setAttribute('cx',p.x);halo.setAttribute('cy',p.y);halo.setAttribute('visibility','visible');tip.innerHTML=formatter(p.data,i);tip.classList.add('show');const rect=svg.getBoundingClientRect(),px=p.x/W*rect.width;tip.style.left=Math.max(90,Math.min(rect.width-90,px))+'px';if(i!==current&&ev?.pointerType==='touch'&&navigator.vibrate)navigator.vibrate(5);current=i}function move(ev){const q=viewPoint(svg,ev,W,H);let best=0,bd=Infinity;points.forEach((p,i)=>{const dx=p.x-q.x,dy=p.y-q.y,d=dx*dx+dy*dy;if(d<bd){bd=d;best=i}});show(best,ev)}container.addEventListener('pointermove',move);container.addEventListener('pointerdown',move);container.addEventListener('pointerleave',ev=>{if(ev.pointerType!=='touch'){tip.classList.remove('show');halo.setAttribute('visibility','hidden')}});container.addEventListener('keydown',ev=>{if(!['ArrowLeft','ArrowRight'].includes(ev.key))return;ev.preventDefault();show(current<0?0:current+(ev.key==='ArrowRight'?1:-1))})}
function svgLine(vals,labels,min,max,color='var(--yellow)',second=null){const W=720,H=210,L=35,R=15,T=18,B=28,x=i=>L+i*(W-L-R)/(Math.max(1,vals.length-1)),y=v=>T+(max-v)*(H-T-B)/(max-min);let s='';for(let i=0;i<4;i++){let yy=T+i*(H-T-B)/3;s+=`<line class="gridline" x1="${L}" y1="${yy}" x2="${W-R}" y2="${yy}"/>`}s+=`<path class="chart-line" style="stroke:${color}" d="${vals.map((v,i)=>(i?'L':'M')+x(i)+','+y(v)).join(' ')}"/>`;const points=vals.map((v,i)=>({x:x(i),y:y(v),data:null}));vals.forEach((v,i)=>s+=`<circle class="chart-dot" style="stroke:${color}" cx="${x(i)}" cy="${y(v)}" r="4"/><text x="${x(i)}" y="200" text-anchor="middle">${labels[i]}</text>`);if(second){const yy=v=>T+(second.max-v)*(H-T-B)/(second.max-second.min);s+=`<path class="chart-line alt" d="${second.vals.map((v,i)=>(i?'L':'M')+x(i)+','+yy(v)).join(' ')}"/>`;points.forEach((p,i)=>p.y2=yy(second.vals[i]))}return {html:`<svg viewBox="0 0 ${W} ${H}">${s}</svg>`,points}}
function renderCharts(){const aet=$('aetChart'),scatter=$('runScatter'),recovery=$('recoveryChart'),load=$('loadChart');if(!aet||aet.dataset.rendered)return;if(aet)aet.dataset.rendered='1';let c=svgLine(AET.map(x=>x.phr),AET.map(x=>x.date),2.40,2.64);c.points.forEach((p,i)=>p.data=AET[i]);aet.innerHTML=c.html;installIndexScrubber(aet,c.points,d=>`<b>${d.date} · Run AET</b>Power/HR ${d.phr.toFixed(3)} · ${d.power} W · HR ${d.hr}<br>${Math.floor(d.pace/60)}:${String(d.pace%60).padStart(2,'0')}/km · RE ${d.re.toFixed(2)}`);const W=720,H=210,L=38,R=18,T=18,B=28,x=v=>L+(v-240)/(405-240)*(W-L-R),y=v=>T+(520-v)/(520-315)*(H-T-B);let s='';for(let i=0;i<4;i++){let yy=T+i*(H-T-B)/3;s+=`<line class="gridline" x1="${L}" y1="${yy}" x2="${W-R}" y2="${yy}"/>`}const sp=[];RUNS.forEach(r=>{let col=r[1].includes('AET')?'var(--yellow)':r[1].includes('Mixed')?'var(--blue)':'#777',px=x(r[3]),py=y(r[2]);sp.push({x:px,y:py,data:r});s+=`<circle cx="${px}" cy="${py}" r="5" fill="${col}"/>`});scatter.innerHTML=`<svg viewBox="0 0 ${W} ${H}">${s}<text x="40" y="202">Power →</text><text x="600" y="202">AET yellow · mixed blue · other grey</text></svg>`;installScatterScrubber(scatter,sp,r=>`<b>${r[0]} · ${r[1]}</b>${r[3]} W · ${Math.floor(r[2]/60)}:${String(r[2]%60).padStart(2,'0')}/km<br>Power/HR ${r[4]}`);c=svgLine(WELL.map(x=>x[1]),WELL.map(x=>x[0].split(' ')[0]),55,82,'var(--yellow)',{vals:WELL.map(x=>x[3]),min:30,max:96});c.points.forEach((p,i)=>p.data=WELL[i]);recovery.innerHTML=c.html;installIndexScrubber(recovery,c.points,d=>`<b>${d[0]} · Recovery</b>HRV ${d[1]} ms · RHR ${d[2]} bpm<br>Sleep score ${d[3]}`);let max=Math.max(1,...LOAD.map(x=>x[1])),bw=70,gap=18,L2=35,H2=210,T2=18,B2=30,bars='',bp=[];LOAD.forEach((d,i)=>{let h=(d[1]/max)*(H2-T2-B2),xx=L2+i*(bw+gap),yy=H2-B2-h;bp.push({x:xx+bw/2,y:yy,data:d});bars+=`<rect x="${xx}" y="${yy}" width="${bw}" height="${h}" rx="7" fill="var(--yellow)"/><text x="${xx+bw/2}" y="199" text-anchor="middle">${d[0].split(' ')[0]}</text>`});load.innerHTML=`<svg viewBox="0 0 720 210">${bars}</svg>`;installIndexScrubber(load,bp,d=>`<b>${d[0]} · Normalized Cardio Load</b>NCL ${Number(d[1]).toFixed(2)}`)}
function renderCoverage(){const t=$('coverageTable');if(!t)return;t.innerHTML='<div class="cell head">Capability</div><div class="cell head">Evidence</div><div class="cell head">Current support</div><div class="cell head">Next measurement priority</div>'+CAP.map(c=>`<div class="cell"><b>${c.name}</b><br><span class="muted">${c.status}</span></div><div class="cell" style="color:${capColor(c.evidence)};font-weight:900">${c.evidence}</div><div class="cell muted">${c.summary}</div><div class="cell muted">${c.next}</div>`).join('')}
function renderAB(){const a=$('aSel'),b=$('bSel'),res=$('abResult');if(!a||!b||!res)return;a.innerHTML=AET.map((d,i)=>`<option value="${i}" ${i===AET.length-1?'selected':''}>A · ${d.date}</option>`).join('');b.innerHTML=AET.map((d,i)=>`<option value="${i}" ${i===0?'selected':''}>B · ${d.date}</option>`).join('');function go(){let aa=AET[+a.value],bb=AET[+b.val