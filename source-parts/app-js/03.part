 ${runtimeSource.toUpperCase()} · State ID: ${stateId} · Fail-stale policy active.</div>`;sys.prepend(p)}
function clearLegacyWorkers(){if('serviceWorker'in navigator)navigator.serviceWorker.getRegistrations().then(rs=>Promise.all(rs.map(r=>r.unregister()))).catch(()=>{});if('caches'in window)caches.keys().then(ks=>Promise.all(ks.filter(k=>k.startsWith('fz-performance')).map(k=>caches.delete(k)))).catch(()=>{})}
function animateCounts(){document.querySelectorAll('.countup').forEach(el=>{const target=+el.dataset.target;if(reduce){el.textContent=target;return}const start=performance.now(),dur=1600;function f(t){const p=Math.min(1,(t-start)/dur),e=1-Math.pow(1-p,3);el.textContent=Math.round(target*e);if(p<1)requestAnimationFrame(f)}requestAnimationFrame(f)})}
function capColor(e){return e==='HIGH'?'var(--green)':e==='MODERATE'?'var(--amber)':'var(--red)'}
function renderCaps(){const g=$('capGrid');if(!g)return;g.innerHTML=CAP.map((c,i)=>`<button class="cap ${i===0?'active':''}" data-cap="${c.id}"><div class="cap-head"><span class="cap-name">${c.name}</span><span class="cap-pri">${c.priority}</span></div><div class="cap-status" style="color:${capColor(c.evidence)}">${c.status}</div><div class="evidence">${c.evidence} evidence</div><p>${c.summary}</p></button>`).join('');g.querySelectorAll('.cap').forEach(b=>b.onclick=()=>selectCap(b.dataset.cap));selectCap(CAP[0]?.id)}
function selectCap(id){const c=CAP.find(x=>x.id===id)||CAP[0];if(!c)return;document.querySelectorAll('.cap').forEach(b=>b.classList.toggle('active',b.dataset.cap===id));const map={capTitle:c.name,capStatus:c.status+' · '+c.evidence+' EVIDENCE',capSummary:c.summary,capObs:c.obs,capInf:c.inf,capDecision:c.decision,capNext:c.next};for(const [id2,v] of Object.entries(map)){const el=$(id2);if(el)el.textContent=v}if($('capStatus')){$('capStatus').style.color=capColor(c.evidence)}}
function ensureTooltip(container){let t=container.querySelector('.chart-scrub-tooltip');if(!t){t=document.createElement('div');t.className='chart-scrub-tooltip';container.appendChild(t)}return t}
function viewPoint(svg,ev,W,H){const r=svg.getBoundingClientRect();return{x:(ev.clientX-r.left)/r.width*W,y:(ev.clientY-r.top)/r.height*H,rect:r}}
function addSvgEl(svg,name,attrs){const e=document.createElementNS('http://www.w3.org/2000/svg',name);for(const[k,v]of Object.entries(attrs))e.setAttribute(k,v);svg.appendChild(e);return e}
function installIndexScrubber(container,points,formatter,W=720,H=210){const svg=container.querySelector('svg');if(!svg||!points.length)return;container.tabIndex=0;container.setAttribute('role','application');container.setAttribute('aria-label','Interactive chart. Move pointer or use left and right arrow keys to scrub observations.');const tip=ensureTooltip(container),line=addSvgEl(svg,'line',{class:'scrub-line',y1:18,y2:H-28,visibility:'hidden'}),halo=addSvgEl(svg,'circle',{class:'scrub-halo',r:6,visibility:'hidden'});let halo2=null;if(points.some(p=>Number.isFinite(p.y2))){halo2=addSvgEl(svg,'circle',{class:'scrub-halo alt',r:6,visibility:'hidden'})}let current=-1;function show(i,ev){i=Math.max(0,Math.min(points.length-1,i));const p=points[i];line.setAttribute('x1',p.x);line.setAttribute('x2',p.x);line.setAttribute('visibility','visible');halo.setAttribute('cx',p.x);halo.setAttribute('cy',p.y);halo.setAttribute('visibility','visible');if(halo2&&Number.isFinite(p.y2)){halo2.setAttribute('cx',p.x);halo2.setAttribute('cy',p.y2);halo2.setAttribute('visibility','visible')}tip.innerHTML=formatter(p.data,i);tip.classList.add('show');if(ev){const rect=svg.getBoundingClientRect(),px=p.x/W*rect.width;tip.style.left=Math.max(90,Math.min(rect.width-90,px))+'px'}if(i!==current&&ev?.pointerType==='touch'&&navigator.vibrate)navigator.vibrate(5);current=i}function move(ev){const q=viewPoint(svg,ev,W,H);let best=0,bd=Infinity;points.forEach((p,i)=>{const d=Math.abs(p.x-q.x);if(d<bd){bd=d;best=i}});show(best,ev)}container.addEventListener('pointermove',move);container.addEventListener('pointerdown',ev=>{if(ev.pointerType==='touch')container.setPointerCapture?.(ev.pointerId);move(ev)});container.addEventListener('pointerleave',ev=>{if(ev.pointerType!=='touch'){tip.classList.remove('show');line.setAttribute('visibility','hidden');halo.setAttribute('visibility','hidden');halo2?.setAttribute('visibility','hidden')}});container.addEventListener('keydown',ev=>{if(!['ArrowLeft','ArrowRight'].includes(ev.key))return;ev.preventDefault();show(current<0?0:current+(ev.key==='ArrowRight'?1:-1))})}
