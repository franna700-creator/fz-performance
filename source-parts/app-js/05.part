ue],phr=(aa.phr/bb.phr-1)*100,pow=(aa.power/bb.power-1)*100,pd=aa.pace-bb.pace,hd=aa.hr-bb.hr;res.innerHTML=`<div class="metric"><b>${phr>=0?'+':''}${phr.toFixed(1)}%</b><span>Power/HR</span></div><div class="metric"><b>${pow>=0?'+':''}${pow.toFixed(1)}%</b><span>Power</span></div><div class="metric"><b>${pd===0?'Same':Math.abs(pd)+'s '+(pd<0?'faster':'slower')}</b><span>Pace/km</span></div><div class="metric"><b>${hd>=0?'+':''}${hd} bpm</b><span>Heart rate</span></div>`}a.onchange=go;b.onchange=go;go()}
function initNav(){const pages=[...document.querySelectorAll('.page')],navs=[...document.querySelectorAll('[data-page]')];function showPage(id){pages.forEach(p=>p.classList.toggle('active',p.id===id));navs.forEach(b=>b.classList.toggle('active',b.dataset.page===id));history.replaceState(null,'','#'+id);if(id==='trends')setTimeout(renderCharts,20)}navs.forEach(b=>b.addEventListener('click',()=>showPage(b.dataset.page)));const initial=location.hash.slice(1);if(['today','trends','train','system'].includes(initial))showPage(initial);return showPage}
async function boot(){clearLegacyWorkers();const loaded=await loadRuntimeState();runtimeSource=loaded.source;applyRuntimeState(loaded.state);renderTodayDate();tick();setInterval(tick,1000);const stamp=$('stateStamp');if(stamp&&runtimeState)stamp.textContent=`State ${formatStateTime(runtimeState.runtimePublishedAt||runtimeState.stateId)} · refreshes 06:00 / 13:00 / 20:00 SAST`;initNav();animateCounts();renderCaps();renderCoverage();renderAB();installHealthPanel();if(document.querySelector('#trends.active'))renderCharts();document.documentElement.dataset.fzReady='true'}
boot().catch(err=>{console.error('FZ boot failure',err);document.documentElement.dataset.fzReady='degraded';renderTodayDate();tick();setInterval(tick,1000);installHealthPanel()});
