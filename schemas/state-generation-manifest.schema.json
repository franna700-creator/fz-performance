{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fz-performance-mvp.vercel.app/schemas/state-generation-manifest.schema.json",
  "title": "FZ Runtime Generation Manifest",
  "type": "object",
  "required": ["schemaVersion", "generationId", "stateId", "masterValidated", "compressedSha256", "chunks"],
  "properties": {
    "schemaVersion": {"const": "1.1"},
    "generationId": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "stateId": {"type": "string", "minLength": 8},
    "masterValidated": {"const": true},
    "masterAsOf": {"type": "string"},
    "publishedAt": {"type": "string"},
    "nextRefreshAt": {"type": "string"},
    "encoding": {"const": "gzip-split"},
    "compressedSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "uncompressedSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "chunks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "size", "sha256"],
        "properties": {
          "path": {"type": "string", "pattern": "^/generations/[a-f0-9]{64}/state-[0-9]{2}\\.bin$"},
          "size": {"type": "integer", "minimum": 1, "maximum": 1048576},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": true
}
