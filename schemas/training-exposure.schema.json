{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fz-performance/schemas/training-exposure.schema.json",
  "title": "FZ Training Exposure",
  "type": "object",
  "required": ["exposureId","date","source","title","recordStatus"],
  "properties": {
    "exposureId":{"type":"string","minLength":1},
    "date":{"type":"string","format":"date"},
    "source":{"type":"string"},
    "sourceActivityId":{"type":["string","null"]},
    "sport":{"type":["string","null"]},
    "subSport":{"type":["string","null"]},
    "title":{"type":"string"},
    "trainingClass":{"type":["string","null"]},
    "plannedStatus":{"enum":["PLANNED","UNPLANNED","UNKNOWN",null]},
    "executionStatus":{"enum":["COMPLETED","MODIFIED","ABORTED","PARTIAL","UNKNOWN",null]},
    "durationMin":{"type":["number","null"]},
    "distanceKm":{"type":["number","null"]},
    "avgHr":{"type":["number","null"]},
    "maxHr":{"type":["number","null"]},
    "avgPower":{"type":["number","null"]},
    "paceSecPerKm":{"type":["number","null"]},
    "ncl":{"type":["number","null"]},
    "hrEffort":{"type":["number","null"]},
    "matchedFamily":{"type":["string","null"]},
    "capabilityTargets":{"type":"array","items":{"type":"string"}},
    "localCostObserved":{"type":["string","null"]},
    "eventRelevance":{"type":["string","null"]},
    "decisionId":{"type":["string","null"]},
    "recordStatus":{"enum":["RECONCILED","BACKFILLED","SUPERSEDED"]},
    "provenanceNote":{"type":["string","null"]}
  },
  "additionalProperties": false
}
