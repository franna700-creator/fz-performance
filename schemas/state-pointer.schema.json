{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fz-performance-mvp.vercel.app/schemas/state-pointer.schema.json",
  "title": "FZ Runtime Current Pointer",
  "type": "object",
  "required": ["schemaVersion", "pointerVersion", "publishedAt", "current"],
  "properties": {
    "schemaVersion": {"const": "1.1"},
    "pointerVersion": {"type": "integer", "minimum": 1},
    "publishedAt": {"type": "string"},
    "baseGenerationId": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "current": {"$ref": "#/$defs/ref"},
    "previous": {"anyOf": [{"$ref": "#/$defs/ref"}, {"type": "null"}]}
  },
  "$defs": {
    "ref": {
      "type": "object",
      "required": ["generationId", "manifestPath", "stateId", "compressedSha256"],
      "properties": {
        "generationId": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "manifestPath": {"type": "string", "pattern": "^/generations/[a-f0-9]{64}/manifest\\.json$"},
        "stateId": {"type": "string", "minLength": 8},
        "compressedSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
