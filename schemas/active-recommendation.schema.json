{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fz-performance.local/schemas/active-recommendation.schema.json",
  "title": "FZ Tranche 4.4 Active Recommendation",
  "type": "object",
  "required": ["schemaVersion", "contextType", "status", "recommendationVersion", "shadowRecommendationId", "contextFingerprint", "fzRecommendedLane", "safetyOverride", "confidence", "lanes", "athleteSelection", "context", "provenance", "rules"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "contextType": { "const": "ACTIVE_RECOMMENDATION" },
    "status": { "enum": ["READY", "WITHHELD"] },
    "engineVersion": { "type": ["string", "null"] },
    "recommendationVersion": { "type": "string", "minLength": 1 },
    "shadowRecommendationId": { "type": "string", "minLength": 1 },
    "contextFingerprint": { "type": "string", "minLength": 1 },
    "localDate": { "type": ["string", "null"], "format": "date" },
    "fzRecommendedLane": { "oneOf": [{ "$ref": "#/$defs/lane" }, { "type": "null" }] },
    "safetyOverride": { "type": "boolean" },
    "confidence": { "enum": ["LOW", "MODERATE", "HIGH"] },
    "reasonCode": { "type": ["string", "null"] },
    "reason": { "type": ["string", "null"] },
    "explanation": { "type": ["object", "null"] },
    "sessionOptionComposerVersion": { "type": ["string", "null"] },
    "lanes": {
      "type": "object",
      "required": ["ABSORB", "MAINTAIN", "ADAPT"],
      "properties": {
        "ABSORB": { "$ref": "#/$defs/laneOptions" },
        "MAINTAIN": { "$ref": "#/$defs/laneOptions" },
        "ADAPT": { "$ref": "#/$defs/laneOptions" }
      },
      "additionalProperties": false
    },
    "athleteSelection": { "type": "null" },
    "context": {
      "type": "object",
      "required": ["runtimeStateId", "materialityAssessmentId", "primaryObjective", "assumptions"],
      "properties": {
        "runtimeStateId": { "type": ["string", "null"] },
        "materialityAssessmentId": { "type": ["string", "number", "null"] },
        "primaryObjective": { "type": ["string", "null"] },
        "objectiveSource": { "type": ["string", "null"] },
        "measurementHierarchyId": { "type": ["string", "null"] },
        "assumptions": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "provenance": {
      "type": "object",
      "required": ["sourceContract", "sourceRecommendationId", "sourceContextFingerprint"],
      "properties": {
        "sourceContract": { "const": "RECOMMENDATION_SHADOW" },
        "sourceRecommendationId": { "type": "string", "minLength": 1 },
        "sourceContextFingerprint": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "rules": { "type": "object" }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "READY" } } },
      "then": { "properties": { "fzRecommendedLane": { "$ref": "#/$defs/lane" } } }
    },
    {
      "if": { "properties": { "status": { "const": "WITHHELD" } } },
      "then": { "properties": { "fzRecommendedLane": { "type": "null" } } }
    }
  ],
  "$defs": {
    "lane": { "enum": ["ABSORB", "MAINTAIN", "ADAPT"] },
    "laneOptions": { "type": "array", "minItems": 0, "maxItems": 3, "items": { "$ref": "#/$defs/sessionOption" } },
    "sessionOption": {
      "type": "object",
      "required": ["optionId", "title", "modality", "objective", "dose", "expectedCost", "whyNow", "confidence"],
      "properties": {
        "optionId": { "type": "string", "minLength": 1 },
        "rank": { "type": "integer", "minimum": 1, "maximum": 3 },
        "title": { "type": "string", "minLength": 1 },
        "modality": { "type": "string", "minLength": 1 },
        "sessionKind": { "type": ["string", "null"] },
        "objective": { "type": "string", "minLength": 1 },
        "dose": { "type": "string", "minLength": 1 },
        "expectedCost": { "enum": ["LOW", "LOW_TO_MODERATE", "MODERATE", "MODERATE_TO_HIGH", "HIGH"] },
        "whyNow": { "type": "string", "minLength": 1 },
        "successCondition": { "type": ["string", "null"] },
        "stopCondition": { "type": ["string", "null"] },
        "targetedGaps": { "type": "array", "items": { "type": "string" } },
        "confidence": { "enum": ["LOW", "MODERATE", "HIGH"] },
        "matchHints": { "type": "object" },
        "evidenceBasis": { "type": "array", "items": { "type": "string" } },
        "composerVersion": { "type": "string" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
