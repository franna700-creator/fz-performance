{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fz-performance-mvp.vercel.app/schemas/runtime-state.schema.json",
  "title": "FZ Performance Runtime State",
  "type": "object",
  "required": ["schemaVersion", "stateId", "masterValidated", "nextRefreshAt", "pages", "datasets"],
  "properties": {
    "schemaVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+(?:\\.[0-9]+)?$"},
    "shellVersion": {"type": "string"},
    "shellMinimumVersion": {"type": "string"},
    "stateId": {"type": "string", "minLength": 8},
    "masterValidated": {"const": true},
    "masterAsOf": {"type": "string"},
    "publishedAt": {"type": "string"},
    "runtimePublishedAt": {"type": "string"},
    "nextRefreshAt": {"type": "string", "minLength": 8},
    "scheduleSAST": {
      "type": "array",
      "prefixItems": [{"const": 6}, {"const": 20}],
      "minItems": 2,
      "maxItems": 2
    },
    "pages": {
      "type": "object",
      "required": ["today", "trends", "train", "system"],
      "properties": {
        "today": {"type": "string", "minLength": 32},
        "trends": {"type": "string", "minLength": 32},
        "train": {"type": "string", "minLength": 32},
        "system": {"type": "string", "minLength": 32}
      },
      "additionalProperties": true
    },
    "datasets": {
      "type": "object",
      "required": ["AET", "WELL", "LOAD", "RUNS", "CAP"],
      "properties": {
        "AET": {"type": "array"},
        "WELL": {"type": "array"},
        "LOAD": {"type": "array"},
        "RUNS": {"type": "array"},
        "CAP": {"type": "array", "minItems": 1},
        "WELLNESS_HISTORY": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["date", "status"],
            "properties": {
              "date": {"type": "string", "minLength": 6},
              "dateLabel": {"type": "string"},
              "hrv": {"type": ["number", "null"]},
              "rhr": {"type": ["number", "null"]},
              "sleepHours": {"type": ["number", "null"]},
              "sleepScore": {"type": ["number", "null"]},
              "bodyBatteryHigh": {"type": ["number", "null"]},
              "completedDayStress": {"type": ["number", "null"]},
              "completedDaySteps": {"type": ["number", "null"]},
              "completedDayActiveCalories": {"type": ["number", "null"]},
              "fzReadiness": {"type": ["number", "null"]},
              "status": {"enum": ["HISTORICAL", "LIVE / PARTIAL", "LEGACY GAP"]},
              "provenance": {"type": "string"}
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "runtimeMode": {"type": "string"},
    "runtimeStateEndpoint": {"type": "string"}
  },
  "additionalProperties": true
}
